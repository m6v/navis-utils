# Группа, объединяющая всех участников учебного класса
[class:children]
instructor
learners

# Рабочее место инструктора (Instructor Workstation)
[instructor]
iws ansible_host=127.0.0.1

# Рабочие места обучаемых (Learner Workstations)
[learners]
lws-01 ansible_host=192.168.1.128
lws-02 ansible_host=192.168.1.12
lws-03 ansible_host=192.168.1.13
lws-04 ansible_host=192.168.1.14
lws-05 ansible_host=192.168.1.15

# Общие переменные для всех хостов
[all:vars]
ansible_connection=ssh
