<domain type='kvm'>
  <name>{{ item }}</name>
  <title>КШ</title>
  <description>Криптошлюз "Континент"</description>
  <memory unit='KiB'>524288</memory>
  <currentMemory unit='KiB'>524288</currentMemory>
  <vcpu placement='static'>1</vcpu>

  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>

  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://freebsd.org/freebsd/12.4" label="FreeBSD 12.4"/>
    </libosinfo:libosinfo>
  </metadata>

  <features>
    <acpi/>
    <apic/>
  </features>

  <cpu mode='host-passthrough'/>
  <clock offset='utc'/>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <disk type='volume' device='disk'>
      <driver name='qemu' type='qcow2' cache='writeback'/>
      <source pool='{{ user_pool_name }}' volume='{{ item }}.qcow2'/>
      <target dev='sda' bus='sata'/>
      <address type="drive" controller="0" bus="0" target="0" unit="0"/>
    </disk>

    <interface type='network'>
      <mac address='08:00:27:3e:be:f3'/>
      <source network='intnet'/>
      <model type='e1000'/>
    </interface>
 
    <interface type='network'>
      <mac address='08:00:27:3e:be:f4'/>
      <source network='extnet'/>
      <model type='e1000'/>
    </interface>

    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>

    <video>
      <model type='virtio' vram='65536' heads='1' primary='yes'/>
    </video>

    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
