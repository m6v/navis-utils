[Unit]
Description=Instructor's Web Panel
After=network.target libvirtd.service
Requires=libvirtd.service

[Service]
Type=simple

WorkingDirectory=/usr/share/novnc
ExecStart=/srv/vlab-panel/server.py

User=root
Group=root

Restart=on-failure
RestartSec=5s

KillMode=control-group
TimeoutStopSec=10s

[Install]
WantedBy=multi-user.target
