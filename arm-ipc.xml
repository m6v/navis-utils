<domain type='kvm'>
  <name>arm-ipc</name>
  <title>АРМ управления СКЗИ</title>
  <description>АРМ управления АПКШ "Континент". Для входа использовать логин 'administrator' и пароль '11111111'</description>
  <memory unit='KiB'>4194304</memory>
  <currentMemory unit='KiB'>4194304</currentMemory>
  <vcpu placement='static'>2</vcpu>

  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>

  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://microsoft.com/win/10" label="Microsoft Windows 10"/>
    </libosinfo:libosinfo>
  </metadata>

  <features>
    <acpi/>
    <apic/>
  </features>

  <cpu mode='host-passthrough'/>
  <clock offset='utc'/>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <disk type='volume' device='disk'>
      <driver name='qemu' type='qcow2' cache='writeback'/>
      <source pool='$pool_name' volume='arm-ipc.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>

    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>

    <interface type='network'>
      <source network='extnet'/>
      <model type='virtio'/>
    </interface>

    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>

    <video>
      <model type='virtio' vram='65536' heads='1' primary='yes'/>
    </video>

    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
