[Unit]
Description=Service Container for vlab
After=network.target systemd-journald.service
Requires=systemd-journald.service

[Service]
Type=simple
Environment="STORAGE_ROOT=/var/lib/machines/timemachine"

# Останов контейнера и размонтирование оверлея на случай некорректного завершения работы прошлого инстанса
ExecStartPre=-/usr/bin/machinectl terminate timemachine
ExecStartPre=-/usr/bin/umount -l ${STORAGE_ROOT}/merged

# Сборка оверлея
ExecStartPre=/usr/bin/mkdir -p ${STORAGE_ROOT}/upper ${STORAGE_ROOT}/work ${STORAGE_ROOT}/merged
ExecStartPre=/usr/bin/mount -t overlay overlay -o lowerdir=/,upperdir=${STORAGE_ROOT}/upper,workdir=${STORAGE_ROOT}/work ${STORAGE_ROOT}/merged

# Пересчет смещения времени
ExecStartPre=-/usr/local/bin/timemachine.py

# Запуск контейнера
ExecStart=/usr/bin/systemd-nspawn --keep-unit --machine=timemachine -D ${STORAGE_ROOT}/merged /entrypoint.sh

# Размонтирование оверлея
ExecStopPost=/usr/bin/umount -l ${STORAGE_ROOT}/merged

KillMode=mixed
TimeoutStopSec=10
Restart=no

[Install]
WantedBy=multi-user.target
