[Unit]
Description=TimeMachine NTP Service Container
After=network.target

[Service]
Type=simple

# Перед стартом собираем слои оверлея
ExecStartPre=/usr/bin/mkdir -p /var/lib/machines/ntp-container/upper /var/lib/machines/ntp-container/work /var/lib/machines/ntp-container/merged
ExecStartPre=/usr/bin/mount -t overlay overlay -o lowerdir=/,upperdir=/var/lib/machines/ntp-container/upper,workdir=/var/lib/machines/ntp-container/work /var/lib/machines/ntp-container/merged

ExecStart=/usr/local/bin/timemachine.sh start
ExecStop=/usr/local/bin/timemachine.sh stop
ExecStopPost=/usr/bin/umount /var/lib/machines/ntp-container/merged

KillMode=mixed
TimeoutStopSec=15
Restart=no

[Install]
WantedBy=multi-user.target
