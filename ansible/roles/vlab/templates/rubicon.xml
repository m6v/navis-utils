<domain type='kvm'>
  <name>{{ item }}</name>
  <title>ПАК "Рубикон"</title>
  <description>Программно-аппаратный комплекс «Комплекс противодействия программно-аппаратным воздействиям (КП ПАВ) «Рубикон» с поддержкой виртуальных сетей. Для входа в консоль восстановления использовать логин и пароль 'rescue'</description>
  <memory unit='KiB'>1048576</memory>
  <currentMemory unit='KiB'>1048576</currentMemory>
  <vcpu placement='static'>1</vcpu>

  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>

  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://debian.org/debian/10" label="Debian 10"/>
    </libosinfo:libosinfo>
  </metadata>

  <features>
    <acpi/>
    <apic/>
  </features>

  <cpu mode='host-passthrough'/>
  <clock offset='utc'/>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

    <disk type='volume' device='disk'>
      <driver name='qemu' type='qcow2' cache='writeback'/>
      <source pool='{{ user_pool_name }}' volume='{{ item }}.qcow2'/>
      <target dev='vda' bus='virtio'/>
    </disk>

    <interface type='network'>
      <mac address='08:00:27:3e:be:a1'/>
      <source network='intnet'/>
      <model type='e1000'/>
    </interface>

    <interface type='network'>
      <mac address='08:00:27:3e:be:a2'/>
      <source network='intnet'/>
      <model type='e1000'/>
    </interface>

    <interface type='network'>
      <mac address='08:00:27:3e:be:a3'/>
      <source network='intnet'/>
      <model type='e1000'/>
    </interface>

    <interface type='network'>
      <mac address='08:00:27:3e:be:a4'/>
      <source network='extnet'/>
      <model type='e1000'/>
    </interface>

    <graphics type="spice" autoport="yes">
      <listen type="address"/>
      <image compression="off"/>
      <gl enable="no"/>
    </graphics>

    <graphics type='vnc' port='5911' autoport='no' listen='0.0.0.0'>
      <listen type='address' address='0.0.0.0'/>
    </graphics>

    <video>
      <model type='virtio' vram='65536' heads='1' primary='yes'/>
    </video>

    <console type='pty'>
      <target type='serial' port='0'/>
    </console>
  </devices>
</domain>
