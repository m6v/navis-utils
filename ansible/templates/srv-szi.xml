<domain type='kvm'>
  <name>{{ item.path | basename | regex_replace('\.qcow2$', '') }}</name>
  <title>Сервер СЗИ</title>
  <description></description>
  <memory unit='KiB'>4194304</memory>
  <currentMemory unit='KiB'>4194304</currentMemory>
  <vcpu placement='static'>2</vcpu>

  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>

  <metadata>
    <libosinfo:libosinfo xmlns:libosinfo="http://libosinfo.org/xmlns/libvirt/domain/1.0">
      <libosinfo:os id="http://astralinux.ru/astralinux/smolensk.1.7" label="Astra Linux SE 1.7"/>
    </libosinfo:libosinfo>
  </metadata>

  <features>
    <acpi/>
    <apic/>
  </features>

  <cpu mode='host-passthrough'/>
  <clock offset='utc'/>

  <devices>
    <emulator>/usr/bin/qemu-system-x86_64</emulator>

  <disk type='volume' device='disk'>
    <driver name='qemu' type='qcow2' cache='writeback'/>
    <source pool='{{ username }}' volume='{{ item.path | basename | regex_replace('\.qcow2$', '') }}.qcow2'/>
    <target dev='vda' bus='virtio'/>
  </disk>

    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>

    <interface type='network'>
      <source network='intnet'/>
      <model type='virtio'/>
    </interface>

    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>

    <video>
      <model type='virtio' vram='65536' heads='1' primary='yes'/>
    </video>

    <console type='pty'>
      <target type='serial' port='0'/>
    </console>

    <channel type="unix">
      <target type="virtio" name="org.qemu.guest_agent.0"/>
      <address type="virtio-serial" controller="0" bus="0" port="1"/>
    </channel>

  </devices>
</domain>
