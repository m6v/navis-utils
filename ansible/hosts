# Группа, объединяющая всех участников учебного класса
[class:children]
instructor
learners

# Рабочее место инструктора (Instructor Workstation)
[instructor]
iws ansible_host=192.168.1.10

# Рабочие места обучаемых (Learner Workstations)
[learners]
# Старая версия ansible на Astra Linux 1.7 не умеет раскрывать скобки
# lws-[01:10] ansible_host=192.168.1.[11:20]
lws-01 ansible_host=192.168.1.11

# Общие переменные для всех хостов
[all:vars]
ansible_connection=ssh
ansible_user=administrator
